<?xml version="1.0"?>
<ruleset name="Custom Metrics Ruleset"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0
                             https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>
        Customized PMD ruleset covering five OO metrics:
        Lines of Code (LoC), Cyclomatic Complexity (CC),
        Weighted Methods per Class (WMC), Coupling Between Objects (CBO),
        and Lack of Cohesion in Methods (LCOM).
    </description>

    <!-- ===== 1. Lines of Code (LoC) ===== -->

    <!-- Flags methods whose physical line count is too high -->
    <rule ref="category/java/design.xml/ExcessiveMethodLength">
        <properties>
            <property name="minimum" value="50" />
        </properties>
    </rule>

    <!-- Flags classes whose physical line count is too high -->
    <rule ref="category/java/design.xml/ExcessiveClassLength">
        <properties>
            <property name="minimum" value="500" />
        </properties>
    </rule>

    <!-- Non-Commenting Source Statements: the most direct LoC measure,
         counting only executable statements (not blank lines or comments) -->
    <rule ref="category/java/design.xml/NcssCount">
        <properties>
            <property name="methodReportLevel" value="30" />
            <property name="classReportLevel"  value="200" />
        </properties>
    </rule>

    <!-- ===== 2. Cyclomatic Complexity (CC) ===== -->

    <!-- Classic McCabe CC: counts independent paths through a method -->
    <rule ref="category/java/design.xml/CyclomaticComplexity">
        <properties>
            <property name="methodReportLevel" value="10" />
            <property name="classReportLevel"  value="80" />
        </properties>
    </rule>

    <!-- NPath Complexity: counts the number of acyclic execution paths,
         a finer-grained companion metric to CC -->
    <rule ref="category/java/design.xml/NPathComplexity">
        <properties>
            <property name="reportLevel" value="200" />
        </properties>
    </rule>

    <!-- Cognitive Complexity: measures how hard code is to understand,
         closely related to CC but penalises nesting more heavily -->
    <rule ref="category/java/design.xml/CognitiveComplexity">
        <properties>
            <property name="reportLevel" value="15" />
        </properties>
    </rule>

    <!-- ===== 3. Weighted Methods per Class (WMC) ===== -->

    <!-- Flags classes with too many methods (unweighted WMC proxy) -->
    <rule ref="category/java/design.xml/TooManyMethods">
        <properties>
            <property name="maxmethods" value="10" />
        </properties>
    </rule>

    <!-- Flags classes with too many public methods and fields,
         capturing the externally-visible complexity component of WMC -->
    <rule ref="category/java/design.xml/ExcessivePublicCount">
        <properties>
            <property name="minimum" value="45" />
        </properties>
    </rule>

    <!-- ===== 4. Coupling Between Objects (CBO) ===== -->

    <!-- Counts unique types referenced in fields, locals, and return types -->
    <rule ref="category/java/design.xml/CouplingBetweenObjects">
        <properties>
            <property name="threshold" value="10" />
        </properties>
    </rule>

    <!-- Counts import statements as a direct, easily observable CBO proxy -->
    <rule ref="category/java/design.xml/ExcessiveImports">
        <properties>
            <property name="minimum" value="20" />
        </properties>
    </rule>

    <!-- ===== 5. Lack of Cohesion in Methods (LCOM) ===== -->

    <!-- Flags classes with too many fields, indicating low cohesion -->
    <rule ref="category/java/design.xml/TooManyFields">
        <properties>
            <property name="maxfields" value="10" />
        </properties>
    </rule>

    <!-- God Class: detects classes that monopolise data and behaviour,
         the canonical high-LCOM anti-pattern -->
    <rule ref="category/java/design.xml/GodClass" />

</ruleset>
